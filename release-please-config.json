          "jsonpath": "$..[?(@.path && @.version)].version"
        },
        {
          "type": "toml",
          "path": "apps/relay/Cargo.toml",
          "jsonpath": "$..[?(@.path && @.version)].version"
        },
        {
          "type": "toml",
          "path": "Cargo.lock",
          "jsonpath": "$.package[?(!@.source)].version"
        },
        {
          "type": "toml",
          "path": "fuzz/Cargo.lock",
          "jsonpath": "$.package[?(@.name.value !== 'frasil-fuzz' && !@.source)].version"
        },
        {
          "type": "toml",
          "path": "apps/relay/fuzz/Cargo.lock",
          "jsonpath": "$.package[?(@.name.value !== 'frasil-relay-fuzz' && !@.source)].version"
        },
        {
          "type": "json",
          "path": "packages/frasil/package.json",
          "jsonpath": "$.version"
        }
      ]
    }
  }
}
