{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/{engine-compiled,engine-embedded,indexed,compiled,load}.ts",
    "bench/run.mjs",
    "test/binding/{page,index-worker}.js"
  ],
  "project": ["src/**/*.ts", "test/**/*.{ts,js}", "scripts/*.mjs", "bench/*.mjs"],
  "ignoreBinaries": ["rustc"],
  "rules": {
    "exports": "warn",
    "types": "warn"
  }
}
